{
  "includeCoAuthoredBy": false,
  "model": "opus",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "code-review@claude-plugins-official": true
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "theme": "dark",
  "outputStyle": "charlie",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/charlie/.claude/hooks/block-protected-branch-commit.py",
            "timeout": 10,
            "statusMessage": "Checking branch protection"
          }
        ]
      }
    ]
  }
}
