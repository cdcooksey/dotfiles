# The syntax is "key = value". The whitespace around the
# equals doesn't matter.
background = 181926
foreground = fff
background-opacity = 0.8

# Empty values reset the configuration to the default value
font-family =

# quit-after-last-window-closed = true
# quit-after-last-window-closed-delay = 20m

image-storage-limit = 320000000


# Linux: wallpaper colours generated by DankMaterialShell. Optional include;
# absent on macOS, so the background/foreground above apply there.
config-file = ?themes/dankcolors
